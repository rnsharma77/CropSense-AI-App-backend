# CropSense Backend Environment Variables
# Copy this file to .env and fill in actual values
# NEVER commit .env file to version control

# ===== DATABASE =====
# MongoDB connection string
# Get from MongoDB Atlas: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cropsense?retryWrites=true&w=majority

# ===== API KEYS =====
# Gemini API (for agricultural advisory via AI)
# Get from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Plant.id API (for disease identification)
# Get from https://plant.id
PLANT_ID_API_KEY=your_plant_id_api_key_here

# ===== AUTHENTICATION =====
# JWT secret for authentication tokens (change in production!)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_secure_jwt_secret_here

# Google OAuth
# Get from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ===== SERVER CONFIGURATION =====
# Frontend URL for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-vercel-app.vercel.app

# Server port
PORT=8080

# Python path (usually auto-detected, set if issues)
PYTHON_PATH=/usr/bin/python3

# Render-specific
RENDER=true

# Machine learning artifacts
# Ignore training dataset and intermediate ML artifacts.
# Keep the trained production model files versioned so Render/Vercel can run inference.
/ml_model/dataset/
/ml_model/*.pt
/ml_model/*.pth
!/ml_model/models/cropsense_model.pth
!/ml_model/models/class_index.json
/ml_model/models/*.log
/api/__pycache__/
/ml/__pycache__/
/ml/*.pyc
/ml/leaf_activity_log.csv

# Temporary prediction files
.tmp-predict/
*.tmp


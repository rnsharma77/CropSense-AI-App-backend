# CropSense Backend - PRODUCTION Environment Variables
# ⚠️ DO NOT COMMIT THIS FILE - USE RENDER DASHBOARD FOR SECRETS
# This is a TEMPLATE - Replace values in Render dashboard environment variables

# Server Configuration (Render will override PORT with $PORT)
PORT=${PORT}
NODE_ENV=production

# Database - MongoDB Atlas (Render Environment Variable)
MONGODB_URI=${MONGODB_URI}

# AI/ML APIs (Render Environment Variables)
GEMINI_API_KEY=${GEMINI_API_KEY}
GEMINI_MODEL=gemini-2.5-flash
PLANT_ID_API_KEY=${PLANT_ID_API_KEY}

# Authentication & Security (Render Environment Variables)
JWT_SECRET=${JWT_SECRET}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}

# CORS Configuration - UPDATE with your production domain
CORS_ORIGINS=https://cropsense.vercel.app,https://your-domain.com

# Production Settings
PYTHON_PATH=/usr/bin/python3
RENDER=true
